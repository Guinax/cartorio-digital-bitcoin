# Merge into the private Core Lightning config on the home Linux machine.
# Consult https://docs.corelightning.org/docs/tor for your CLN version.
network=bitcoin
bitcoin-rpcconnect=127.0.0.1
bitcoin-rpcport=8332
bitcoin-datadir=/var/lib/bitcoind
bind-addr=127.0.0.1:9735
proxy=127.0.0.1:9050
always-use-proxy=true
# Replace placeholder with the .onion HOSTNAME generated by Tor, not a private key:
# announce-addr=YOUR_GENERATED_HOSTNAME.onion:9735
# Do not enable receiving until CLN is synchronized, has inbound liquidity
# and independent, tested wallet/channel recovery procedures are in place.
