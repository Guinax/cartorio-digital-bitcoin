# Binarios usados exclusivamente no laboratorio regtest (SEM mainnet).
FROM bitcoin/bitcoin:29.4 AS bitcoincore
FROM elementsproject/lightningd:v26.06.6
# A imagem oficial do Bitcoin Core instala em /opt/bitcoin-29.4/bin.
COPY --from=bitcoincore /opt/bitcoin-29.4/bin/bitcoin-cli /usr/local/bin/bitcoin-cli
